MEDICATION_APP_NAME=Medication Reminder
MEDICATION_ENVIRONMENT=local
MEDICATION_DEBUG=false
MEDICATION_LOG_LEVEL=INFO
MEDICATION_DATABASE_URL=postgresql+asyncpg://medication:medication@localhost:5432/medication
MEDICATION_REDIS_URL=redis://localhost:6379/0
MEDICATION_TELEGRAM_BOT_TOKEN=
# Необязательно: HTTPS URL будущего Telegram Mini App для определения часового пояса.
MEDICATION_TELEGRAM_MINI_APP_URL=
MEDICATION_REMINDER_BATCH_SIZE=50
MEDICATION_REMINDER_POLL_INTERVAL_SECONDS=10
MEDICATION_REMINDER_RETRY_INTERVAL_SECONDS=60
MEDICATION_REMINDER_CLAIM_TIMEOUT_SECONDS=300
MEDICATION_REMINDER_ATTEMPT_RETENTION_DAYS=90
MEDICATION_SCHEDULE_HORIZON_DAYS=90


# Telegram IDs allowed to use /stats (JSON array). Empty means no admin access.
MEDICATION_TELEGRAM_ADMIN_IDS=[]
